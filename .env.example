# ============================================================
# JARVIS Mark VII — Enterprise Environment Variables
# Copiar este archivo a .env y completar los valores
# NUNCA commitear el archivo .env al repositorio
# ============================================================

# ==========================================
# SPRINT 1: PERSISTENCE LAYER
# ==========================================

# PostgreSQL (requerido en producción)
DATABASE_URL=postgresql://jarvis:jarvis-db-secret@localhost:5432/jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis-db-secret

# Redis (requerido en producción)
REDIS_URL=redis://:jarvis-secret@localhost:6379
REDIS_PASSWORD=jarvis-secret

# ==========================================
# SPRINT 1: VECTOR SEARCH
# ==========================================

# Pinecone (recomendado para producción; opcional, usa fallback local si no está)
PINECONE_API_KEY=
PINECONE_INDEX=jarvis-memories

# OpenAI (para embeddings y LLM fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# SPRINT 2: AI INTEGRATIONS
# ==========================================

# Ollama (LLM local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude
ANTHROPIC_API_KEY=

# Smart Home
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:7777/api/spotify/callback

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:7777/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:7777/api/auth/github/callback

# ==========================================
# SPRINT 3: SECURITY
# ==========================================

# JWT (CAMBIAR EN PRODUCCIÓN — mínimo 32 caracteres)
JWT_SECRET=change-me-in-production-min-32-chars-required

# ==========================================
# SPRINT 4: OBSERVABILITY
# ==========================================

# Jaeger Tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=jarvis-grafana

# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=7777
LOG_LEVEL=info
ENABLE_METRICS=true
