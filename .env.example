# ============================================
# J.A.R.V.I.S. 100% TONY STARK — CONFIGURATION
# ============================================
# Copia este archivo a .env y configura tus credenciales
#
# Instrucciones:
# 1. cp .env.example .env
# 2. Edita .env con tus credenciales reales
# 3. ¡No subas .env a Git!

# ============================================
# SPOTIFY INTEGRATION (FASE 9)
# ============================================
# Obtener en: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=tu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ============================================
# GOOGLE APIs (FASE 8)
# ============================================
# Gmail + Google Calendar
# Obtener en: https://console.cloud.google.com

# Gmail OAuth2
GMAIL_EMAIL=tu_email@gmail.com
GMAIL_CLIENT_ID=tu_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu_gmail_client_secret
GMAIL_REFRESH_TOKEN=tu_refresh_token

# Google Calendar API
GOOGLE_API_KEY=tu_google_api_key_aqui
GOOGLE_CALENDAR_ID=primary

# ============================================
# SMART HOME INTEGRATION (FASE 8)
# ============================================
# Home Assistant
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=tu_home_assistant_long_lived_token

# Philips Hue (alternativa)
PHILIPS_HUE_BRIDGE_IP=192.168.1.XX
PHILIPS_HUE_USERNAME=tu_philips_hue_username

# SmartThings (alternativa)
SMARTTHINGS_TOKEN=tu_smartthings_personal_access_token

# ============================================
# VISION & FACE RECOGNITION (FASE 8 & 9)
# ============================================
# Carpeta con fotos para entrenamiento facial
FACE_TRAINING_DIR=./data/faces
FACE_RECOGNITION_THRESHOLD=0.6

# OpenCV configuración
OPENCV_CAMERA_INDEX=0
OPENCV_RESOLUTION_WIDTH=640
OPENCV_RESOLUTION_HEIGHT=480

# ============================================
# ULTRA MEMORY (FASE 9)
# ============================================
# Pinecone Vector Database (para embeddings)
PINECONE_API_KEY=tu_pinecone_api_key
PINECONE_ENVIRONMENT=tu_pinecone_environment
PINECONE_INDEX_NAME=jarvis-memories

# Alternativa: Local vector DB
ULTRA_MEMORY_MODE=local
ULTRA_MEMORY_DIR=./memory/vectors

# ============================================
# MISTRAL FINE-TUNING (FASE 7)
# ============================================
# Configuración de fine-tuning
MISTRAL_MODEL=mistral:latest
MISTRAL_FINETUNE_EPOCHS=3
MISTRAL_FINETUNE_BATCH_SIZE=4
MISTRAL_FINETUNE_LEARNING_RATE=0.0001

# Directorio de datos para fine-tuning
FINETUNE_DATA_DIR=./memory/training_data

# ============================================
# VOICE RECOGNITION (FASE 7)
# ============================================
# Modelo de voz (VOSK)
VOSK_MODEL_PATH=./models/vosk-model-small-es-0.42
VOSK_LANGUAGE=es-ES

# Wake words personalizadas (separadas por coma)
WAKE_WORDS=jarvis,oye jarvis,hey jarvis,j.a.r.v.i.s

# Threshold de confianza (0-1)
VOICE_CONFIDENCE_THRESHOLD=0.8

# ============================================
# OLLAMA (Sistema base)
# ============================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# ============================================
# PYTHON AI ENGINE (Sistema base)
# ============================================
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# ============================================
# REMOTE API (FASE 6)
# ============================================
REMOTE_API_PORT=3001
REMOTE_API_JWT_SECRET=tu_jwt_secret_muy_secreto_aqui

# ============================================
# GITHUB INTEGRATION (Sistema base)
# ============================================
GITHUB_TOKEN=tu_github_personal_access_token

# ============================================
# GENERAL SETTINGS
# ============================================
NODE_ENV=production
LOG_LEVEL=info
TIMEZONE=America/Buenos_Aires

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# ⚠️  PRIVACIDAD:
# - No subas este archivo a GitHub con credenciales reales
# - Usa .gitignore para excluir .env
#
# 📋 OPCIONAL:
# - No todas las credenciales son necesarias
# - El sistema funciona sin Smart Home/Spotify/etc
# - Solo se requieren Ollama + Python para funcionamiento básico
#
# 🔐 SEGURIDAD:
# - Genera JWT_SECRET único: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - Usa tokens de solo lectura cuando sea posible
# - Revoca tokens viejos regularmente
#
# 🚀 INICIO RÁPIDO:
# - Mínimo requerido: Ollama instalado y corriendo
# - Resto es opcional para funcionalidades avanzadas
