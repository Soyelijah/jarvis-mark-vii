{
  "name": "jarvis-enterprise",
  "version": "1.0.0-enterprise",
  "description": "J.A.R.V.I.S. Enterprise Edition - Sistema de Mayordomo Personal Inteligente",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "jarvis": "node jarvis-complete.js",
    "autonomous": "node test-autonomous-agent.js",
    "web-intel": "node test-web-intelligence.js",
    "pure": "node jarvis-pure-start.js",
    "pure:memory": "node core/jarvis-with-memory.cjs",
    "proactive": "node jarvis-proactive.cjs",
    "complete": "node main-complete.js",
    "fase7": "node main-fase7.js",
    "ultimate": "node main-ultimate.js",
    "remote": "node remote-server.js",
    "dev": "nodemon app.js",
    "dev:pure": "nodemon jarvis-pure-start.js",
    "clean": "rm -rf logs/* memory/*.db",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd web-interface/backend && jest",
    "test:frontend": "cd web-interface/frontend && npm run test:run",
    "test:coverage": "npm run test:backend -- --coverage && npm run test:frontend -- --coverage",
    "test:watch": "cd web-interface/frontend && npm test",
    "memory": "node core/auto-memory-logger.cjs",
    "memory:test": "node test-auto-memory.cjs",
    "memory:view": "cat memory/context/CURRENT-STATE.json",
    "memory:today": "cat memory/daily/$(date +%Y-%m-%d).md",
    "memory:update-context": "node core/update-claude-context.cjs"
  },
  "keywords": [
    "jarvis",
    "ai",
    "butler",
    "automation"
  ],
  "author": "Enterprise AI Systems",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.30",
    "@anthropic-ai/sdk": "^0.30.1",
    "@octokit/rest": "^20.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "body-parser": "^2.2.0",
    "cheerio": "^1.1.2",
    "chokidar": "^4.0.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "inquirer": "^12.10.0",
    "jsonwebtoken": "^9.0.2",
    "mkdirp": "^3.0.1",
    "mysql2": "^3.6.0",
    "ncp": "^2.0.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.29.1",
    "simple-git": "^3.20.0",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.6",
    "ssh2": "^1.14.0",
    "systeminformation": "^5.27.11"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.1.4"
  },
  "optionalDependencies": {
    "@google-cloud/speech": "^7.2.1",
    "@pinecone-database/pinecone": "^6.1.3",
    "googleapis": "^164.1.0",
    "node-record-lpcm16": "^1.0.1",
    "nodemailer": "^7.0.10",
    "spotify-web-api-node": "^5.0.2",
    "vosk": "^0.3.39"
  }
}
